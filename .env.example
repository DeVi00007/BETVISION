# BETVISION - Környezeti változók
# Másold ezt a fájlt .env néven és töltsd ki az értékeket

# API-Football kulcs (api-football.com)
# Szerezz be egy API kulcsot: https://www.api-football.com/pricing
# Vercel deployment esetén ezt a Vercel Dashboard > Project Settings > Environment Variables
# között kell beállítani VERCEL_API_FOOTBALL_KEY néven
VERCEL_API_FOOTBALL_KEY=your_api_football_key_here
