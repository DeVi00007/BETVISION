{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/sports.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/sports", "destination": "/api/sports" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
