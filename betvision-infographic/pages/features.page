    bounds: [745, 148, 32, 32]
    iconName: "fas:search-dollar"
    fill:
      type: solid
      color: "$accent"

  - elementId: f2-title
    elementType: text
    bounds: [470, 200, 320, 30]
    content:
      fontSize: 20
      color: "$text"
      fontFamily: "Liter"
      wrap: false
      text: |
        <p>Értékkereső Rendszer</p>

  - elementId: f2-body
