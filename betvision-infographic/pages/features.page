pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: page-label
    elementType: text
    bounds: [60, 25, 300, 20]
    content:
      style: "$label"
      text: |
        <p>INNOVÁCIÓK</p>
      wrap: false

  - elementId: page-title
    elementType: text
    bounds: [60, 50, 1000, 55]
    content:
      style: "$title"
      fontSize: 36
      text: |
        <p>5 Innováció, Amivel Nincs Versenytársunk</p>
      wrap: false

  - elementId: title-accent
    elementType: shape
    bounds: [60, 110, 120, 0]
    shapeName: straightConnector1
    border: {style: solid, width: 3, color: "$primary"}

  - elementId: f1-bg
    elementType: shape
    bounds: [60, 130, 370, 240]
    shapeName: rect
    fill:
      type: solid
      color: "$surface"
    border: {style: solid, width: 1, color: "$border"}

  - elementId: f1-top
    elementType: shape
    bounds: [60, 130, 370, 4]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"

  - elementId: f1-num
    elementType: text
    bounds: [75, 148, 70, 50]
    content:
      fontSize: 40
      color: "$primary"
      fontFamily: "Jersey15"
      wrap: false
      text: |
        <p>01</p>

  - elementId: f1-icon
    elementType: icon
    bounds: [350, 148, 32, 32]
    iconName: "fas:brain"
    fill:
      type: solid
      color: "$primary"

  - elementId: f1-title
    elementType: text
    bounds: [75, 200, 320, 30]
    content:
      fontSize: 20
      color: "$text"
      fontFamily: "Liter"
      wrap: false
      text: |
        <p>AI Prediktív Analitika</p>

  - elementId: f1-body
    elementType: text
    bounds: [75, 235, 320, 110]
    content:
      fontSize: 16
      color: "#BBBBBB"
      fontFamily: "MiSans"
      lineHeight: 1.5
      text: |
        <p>Neurális hálózataink 200+ változót elemeznek: forma, sérülések, időjárás, motiváció, történelmi adatok.</p>

  - elementId: f2-bg
    elementType: shape
    bounds: [455, 130, 370, 240]
    shapeName: rect
    fill:
      type: solid
      color: "$surface"
    border: {style: solid, width: 1, color: "$border"}

  - elementId: f2-top
    elementType: shape
    bounds: [455, 130, 370, 4]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: f2-num
    elementType: text
    bounds: [470, 148, 70, 50]
    content:
      fontSize: 40
      color: "$accent"
      fontFamily: "Jersey15"
      wrap: false
      text: |
        <p>02</p>

  - elementId: f2-icon
