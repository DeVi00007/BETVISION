pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: page-label
    elementType: text
    bounds: [60, 25, 300, 20]
    content:
      style: "$label"
      text: |
        <p>ÜZLETI MODELL</p>
      wrap: false

  - elementId: page-title
    elementType: text
    bounds: [60, 50, 900, 55]
    content:
      style: "$title"
      fontSize: 36
      text: |
        <p>Bevételi Modellek és Piaci Lehetőségek</p>
      wrap: false

  - elementId: title-accent
    elementType: shape
    bounds: [60, 110, 120, 0]
    shapeName: straightConnector1
    border: {style: solid, width: 3, color: "$primary"}

  - elementId: r1-bg
    elementType: shape
    bounds: [60, 130, 555, 240]
    shapeName: rect
    fill:
      type: solid
      color: "$surface"
    border: {style: solid, width: 1, color: "$border"}

  - elementId: r1-top
    elementType: shape
    bounds: [60, 130, 555, 4]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"

  - elementId: r1-icon
    elementType: icon
    bounds: [85, 155, 32, 32]
    iconName: "fas:crown"
    fill:
      type: solid
      color: "$primary"

  - elementId: r1-title
    elementType: text
    bounds: [130, 155, 300, 32]
    content:
      fontSize: 20
      color: "$text"
      fontFamily: "Liter"
      wrap: false
      text: |
        <p>Prémium AI Csomag</p>

  - elementId: r1-price
    elementType: text
    bounds: [430, 152, 160, 40]
    content:
      fontSize: 28
      color: "$primary"
      fontFamily: "Jersey15"
      align: [right, middle]
      wrap: false
      text: |
        <p>4,990 Ft/hó</p>

  - elementId: r1-body
    elementType: text
    bounds: [85, 200, 510, 70]
    content:
      fontSize: 16
      color: "#BBBBBB"
      fontFamily: "MiSans"
      lineHeight: 1.5
      text: |
        <p>Napi 5+ VIP tipp, részletes AI elemzés, push értesítések, exkluzív közösségi hozzáférés.</p>

  - elementId: r1-tag
    elementType: text
    bounds: [85, 280, 120, 24]
    content:
      fontSize: 12
      color: "$primary"
      fontFamily: "MiSans"
      wrap: false
      text: |
        <p># Előfizetés</p>

  - elementId: r2-bg
