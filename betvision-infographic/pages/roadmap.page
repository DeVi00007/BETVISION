pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: page-label
    elementType: text
    bounds: [60, 25, 300, 20]
    content:
      style: "$label"
      text: |
        <p>FEJLESZTÉSI TERV</p>
      wrap: false

  - elementId: page-title
    elementType: text
    bounds: [60, 50, 700, 55]
    content:
      style: "$title"
      fontSize: 36
      text: |
        <p>Roadmap — Mit Hoz a Jövő?</p>
      wrap: false

  - elementId: title-accent
    elementType: shape
    bounds: [60, 110, 120, 0]
    shapeName: straightConnector1
    border: {style: solid, width: 3, color: "$primary"}

  - elementId: timeline-line
    elementType: shape
    bounds: [140, 290, 1000, 0]
    shapeName: straightConnector1
    border: {style: solid, width: 3, color: "$primary"}

  - elementId: dot1
    elementType: shape
    bounds: [130, 280, 20, 20]
    shapeName: ellipse
    fill:
      type: solid
      color: "$primary"

  - elementId: q1-bg
    elementType: shape
    bounds: [60, 130, 260, 140]
    shapeName: rect
    fill:
      type: solid
      color: "$surface"
    border: {style: solid, width: 1, color: "$border"}

  - elementId: q1-title
    elementType: text
    bounds: [75, 140, 230, 30]
    content:
      fontSize: 20
      color: "$primary"
      fontFamily: "Liter"
      wrap: false
      text: |
        <p>Q1 2026</p>

  - elementId: q1-body
    elementType: text
    bounds: [75, 175, 230, 80]
    content:
      fontSize: 14
      color: "#BBBBBB"
      fontFamily: "MiSans"
      lineHeight: 1.5
      text: |
        <p>Valós odds API integráció</p>
        <p>iOS és Android natív app</p>
        <p>Fogadási napló (bet history)</p>

  - elementId: q1-down
    elementType: shape
    bounds: [140, 310, 0, 80]
    shapeName: straightConnector1
    border: {style: solid, width: 2, color: "$primary"}

  - elementId: q1-card-bg
    elementType: shape
    bounds: [60, 400, 260, 180]
    shapeName: rect
    fill:
      type: solid
      color: "$surface"
    border: {style: solid, width: 1, color: "$primary"}

  - elementId: q1-card-icon
    elementType: icon
    bounds: [80, 415, 28, 28]
    iconName: "fas:mobile-screen"
    fill:
      type: solid
      color: "$primary"

  - elementId: q1-card-title
