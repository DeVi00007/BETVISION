      style: "$bigNumber"
      fontSize: 52
      wrap: false
      text: |
        <p>15,000+</p>

  - elementId: kpi1-label
    elementType: text
    bounds: [80, 595, 300, 30]
    content:
      style: "$caption"
      fontSize: 16
      text: |
        <p>Regisztrált felhasználó</p>

  - elementId: kpi2-bg
    elementType: shape
    bounds: [450, 500, 360, 150]
    shapeName: rect
    fill:
      type: solid
      color: "$surface"

  - elementId: kpi2-accent
    elementType: shape
    bounds: [450, 500, 360, 4]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: kpi2-number
    elementType: text
    bounds: [470, 525, 200, 65]
    content:
      style: "$bigNumber"
      fontSize: 52
      color: "$accent"
      wrap: false
      text: |
        <p>68%</p>

  - elementId: kpi2-label
    elementType: text
    bounds: [470, 595, 300, 30]
    content:
      style: "$caption"
      fontSize: 16
      text: |
        <p>AI tipp sikerességi arány</p>

  - elementId: kpi3-bg
    elementType: shape
    bounds: [840, 500, 380, 150]
    shapeName: rect
    fill:
      type: solid
      color: "$surface"

  - elementId: kpi3-accent
    elementType: shape
    bounds: [840, 500, 380, 4]
    shapeName: rect
    fill:
      type: solid
      color: "$gold"

  - elementId: kpi3-number
    elementType: text
    bounds: [860, 525, 250, 65]
    content:
      style: "$bigNumber"
      fontSize: 52
      color: "$gold"
      wrap: false
      text: |
        <p>2.4M+</p>

  - elementId: kpi3-label
    elementType: text
    bounds: [860, 595, 300, 30]
    content:
      style: "$caption"
      fontSize: 16
      text: |
        <p>Elemzett mérkőzés</p>

  - elementId: page-num
    elementType: text
    bounds: [1200, 690, 50, 20]
    content:
      fontSize: 12
      color: "$secondary"
      fontFamily: "MiSans"
      align: [right, middle]
      wrap: false
      text: |
        <p>02</p>